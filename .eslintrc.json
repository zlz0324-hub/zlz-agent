{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "plugins": [],
  "rules": {
    "no-console": "warn",
    "no-debugger": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.ts"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "extends": [
        "plugin:@typescript-eslint/recommended"
      ]
    },
    {
      "files": ["**/*.vue"],
      "parser": "vue-eslint-parser",
      "parserOptions": {
        "parser": "@typescript-eslint/parser"
      },
      "plugins": ["vue", "@typescript-eslint"],
      "extends": [
        "plugin:vue/vue3-essential",
        "@vue/typescript/recommended"
      ]
    }
  ]
}